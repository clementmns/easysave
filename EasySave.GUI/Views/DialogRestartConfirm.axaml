<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EasySave.GUI.ViewModels;assembly=EasySave.GUI"
             xmlns:resources="clr-namespace:EasySave.GUI.Resources"
             x:DataType="vm:RestartConfirmDialogViewModel"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="240"
             x:Class="EasySave.GUI.Views.DialogRestartConfirm">
    <Design.DataContext>
        <vm:RestartConfirmDialogViewModel></vm:RestartConfirmDialogViewModel>
    </Design.DataContext>
    <Border Padding="24" Background="{StaticResource SurfaceBrush}">
        <StackPanel Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static resources:Messages.test}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Static resources:Messages.test}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="{x:Static resources:Messages.test}" Command="{Binding CancelCommand}" Classes="ghost" />
                <Button Content="{x:Static resources:Messages.test}" Command="{Binding RestartCommand}" Classes="primary" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
