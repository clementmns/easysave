<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasySave.GUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="EasySave.GUI.Views.MainWindow"
        x:DataType="vm:BackupViewModel"
        Title="EasySave"
        Icon="avares://EasySave.GUI/Ressources/ico/Logo.ico"
        Width="1200" Height="700">
    
    <Grid RowDefinitions="Auto,*,Auto" Margin="0">
        
        <Border Grid.Row="0" 
                Background="#8961CC"
                Padding="20,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                
                <Button Grid.Column="0"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="1"
                        BorderBrush="White"
                        Padding="15,8"
                        CornerRadius="5"
                        Cursor="Hand">
                        <Svg Path="avares://EasySave.GUI/Ressources/svg/settings.svg"
                             Width="18"
                             Height="18"/>
                    
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#34495E"/>
                        </Style>
                    </Button.Styles>
                </Button>
                
                
                <Svg Grid.Column="1"
                       Path="avares://EasySave.GUI/Ressources/svg/Logo.svg"
                       Width="150"
                       Height="40"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Grid>
        </Border>
        
        <Grid Grid.Row="1" ColumnDefinitions="2*,1*" ColumnSpacing="10" Margin="10">
            
            <Border Grid.Column="0" 
                    BorderBrush="Gray" 
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="5">
                <DataGrid ItemsSource="{Binding Jobs}"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Width="40"/>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="50"/>
                        <DataGridTextColumn Header="Nom"
                                            Binding="{Binding Name}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Chemin Source"
                                            Binding="{Binding SourcePath}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Chemin Destination"
                                            Binding="{Binding DestinationPath}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            
            <Border Grid.Column="1" 
                    BorderBrush="LightGray" 
                    BorderThickness="1"
                    CornerRadius="5"
                    Background="WhiteSmoke"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="Détails du job" 
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,10"/>
                </StackPanel>
            </Border>
            
        </Grid>
        
        <Border Grid.Row="2" 
                BorderBrush="Gray" 
                BorderThickness="1,0,1,1"
                Background="WhiteSmoke"
                Padding="15"
                Margin="10,0,10,10">
            
            <Grid ColumnDefinitions="*,Auto">
                
                <StackPanel Grid.Column="0" 
                            VerticalAlignment="Center"
                            Spacing="5">
                    <TextBlock Text="Progression : En attente..." 
                               FontSize="12"
                               Foreground="Gray"/>
                    <ProgressBar Height="20"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 ShowProgressText="True"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            Spacing="10"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <Button Content="Ajouter" 
                            Width="100"
                            Height="35"
                            Click="AddJob_Click"/>
                    <Button Content="Exécuter" 
                            Width="100"
                            Height="35"
                            />
                    <Button Content="Supprimer" 
                            Width="100"
                            Height="35"
                            />
                    <Button Content="Pause" 
                            Width="100"
                            Height="35"
                            />
                </StackPanel>
                
            </Grid>
            
        </Border>
        
    </Grid>
        
</Window>