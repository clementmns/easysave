<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasySave.GUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="EasySave.GUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="EasySave"
        Icon="avares://EasySave.GUI/Assets/ico/Logo.ico"
        xmlns:model="clr-namespace:EasySave.Core.Model;assembly=EasySave.Core"
        xmlns:service="clr-namespace:EasySave.Core.Service;assembly=EasySave.Core"
        xmlns:ressources="clr-namespace:EasySave.GUI.Resources"
        Width="1200" Height="700">

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        
        
        <Border Grid.Row="0" 
                Background="#FF6B6B" 
                Padding="10,8"
                IsVisible="{Binding ProcessMonitor.IsBusinessSoftwareRunning}">
            <StackPanel Orientation="Horizontal" 
                        Spacing="10" 
                        HorizontalAlignment="Center">
                <TextBlock Text="A software has been detected. EasySave will not execute any backup job while it is running."
                           Foreground="White" 
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#8961CC" Padding="20,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <Button Grid.Column="0" 
                        Background="Transparent" 
                        BorderThickness="1" 
                        CornerRadius="5" 
                        Padding="8" 
                        Cursor="Hand"
                        Command="{Binding OpenSettingsDialogCommand}"
                        CommandParameter="{Binding $parent[Window]}">
                    <Svg Path="avares://EasySave.GUI/Assets/svg/settings.svg" 
                         Width="18" 
                         Height="18"/>
                </Button>

                <Svg Grid.Column="1"
                     Path="avares://EasySave.GUI/Assets/svg/Logo.svg"
                     Width="150"
                     Height="40"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding OpenCreateJobDialog}" CommandParameter="{Binding $parent[Window]}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="+" FontWeight="Bold" Foreground="#8961CC" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static ressources:Messages.add}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Fill="Gray" Margin="5,2" VerticalAlignment="Stretch"/>
                <Button Content="{x:Static ressources:Messages.execute}" 
                        Background="Transparent" 
                        BorderThickness="0"
                        IsEnabled="{Binding !ProcessMonitor.IsBusinessSoftwareRunning}"
                        Command="{Binding ExecuteSelectedJobsCommand}"/>
                <Button Content="{x:Static ressources:Messages._break}" Background="Transparent" BorderThickness="0"/>
                
                <Button Content="{x:Static ressources:Messages.delete}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Foreground="Red"
                        Command="{Binding DeleteSelectedJobsCommand}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" MinHeight="300"/>
            </Grid.RowDefinitions>
            
            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Jobs}"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowBackground="White">
                
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="50" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Command="{Binding ((vm:MainViewModel)DataContext).ToggleSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="{x:Static ressources:Messages.name}" Binding="{Binding Name}" Width="2*" IsReadOnly="True" FontWeight="SemiBold"/>
                    
                    <DataGridTextColumn Header="{x:Static ressources:Messages.size}" IsReadOnly="True" Width="100"/>
                    
                    <DataGridTemplateColumn Header="{x:Static ressources:Messages.state}" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#2ecc71" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,2">
                                    <TextBlock Text="PRÊT" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="{x:Static ressources:Messages.test}" IsReadOnly="True" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" 
                          ResizeDirection="Rows" 
                          Background="#DDD" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch"/>

            <TabControl Grid.Row="2"
                        ItemsSource="{Binding SelectedJobs}">

                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="model:BackupJob">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="model:BackupJob">
                        <Border Background="White" 
                                BorderBrush="#E5E5E5" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Margin="10" 
                                Padding="20"
                                BoxShadow="0 4 10 0 #10000000">
                            
                            <Grid RowDefinitions="Auto, *, Auto">
                                
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Backup details" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" Foreground="#333"/>
                                    </StackPanel>
                                    
                                    <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="6" Padding="10,5" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Svg Path="/Assets/svg/info.svg" Width="16" Height="16"/>
                                            <TextBlock Text="{Binding Type}" FontWeight="SemiBold" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto, *" Margin="0,0,0,20" VerticalAlignment="Top">
                                    
                                    <Border Grid.Column="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="15" MinHeight="80" >
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Svg Path="/Assets/svg/folder.svg" Width="18" Height="18"/> 
                                                <TextBlock Text="Source Folder" FontWeight="Bold" Foreground="#374151"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Border>

                                    <Svg Grid.Column="1" Path="/Assets/svg/arrow_right.svg" Width="24" Height="24" Margin="15,0" Opacity="0.3"/>

                                    <Border Grid.Column="2" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="15" MinHeight="80">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Svg Path="/Assets/svg/folder.svg" Width="18" Height="18"/>
                                                <TextBlock Text="Destination Folder" FontWeight="Bold" Foreground="#374151"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DestinationPath}" TextWrapping="Wrap" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" BorderBrush="#EEE" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                        
                                        <Button Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="15,8" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Svg Path="/Assets/svg/pencil.svg" Width="14" Height="14"/>
                                                <TextBlock Text="Edit"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Background="#8961CC" Foreground="White" CornerRadius="4" Padding="15,8" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Svg Path="/Assets/svg/play.svg" Width="14" Height="14"/>
                                                <TextBlock Text="Run now"/>
                                            </StackPanel>
                                        </Button>
                                        
                                    </StackPanel>
                                </Border>
                                
                            </Grid>
                        </Border>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </Grid>
</Window>