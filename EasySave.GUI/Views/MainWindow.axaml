<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasySave.GUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="EasySave.GUI.Views.MainWindow"
        x:DataType="vm:BackupViewModel"
        Title="EasySave"
        Icon="avares://EasySave.GUI/Ressources/ico/Logo.ico"
        xmlns:model="clr-namespace:EasySave.Core.Model;assembly=EasySave.Core"
        Width="1200" Height="700">

    <Grid RowDefinitions="Auto, Auto, *">

        <Border Grid.Row="0" Background="#8961CC" Padding="20,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <Button Grid.Column="0" 
                        Background="Transparent" 
                        BorderThickness="1" 
                        CornerRadius="5" 
                        Padding="8" 
                        Cursor="Hand">
                    <Svg Path="avares://EasySave.GUI/Ressources/svg/settings.svg" 
                         Width="18" 
                         Height="18"/>
                </Button>

                <Svg Grid.Column="1"
                     Path="avares://EasySave.GUI/Ressources/svg/Logo.svg"
                     Width="150"
                     Height="40"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding OpenCreateJobDialog}" CommandParameter="{Binding $parent[Window]}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="+" FontWeight="Bold" Foreground="#8961CC" VerticalAlignment="Center"/>
                        <TextBlock Text="Ajouter" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Fill="Gray" Margin="5,2" VerticalAlignment="Stretch"/>
                <Button Content="Exécuter" Background="Transparent" BorderThickness="0"/>
                <Button Content="Pause" Background="Transparent" BorderThickness="0"/>
                <Button Content="Supprimer" Background="Transparent" BorderThickness="0" Foreground="Red"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="*, 4, *">
            
            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Jobs}"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowBackground="White">
                
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="50" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Command="{Binding ((vm:BackupViewModel)DataContext).ToggleSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*" IsReadOnly="True" FontWeight="SemiBold"/>
                    
                    <DataGridTextColumn Header="Size" IsReadOnly="True" Width="100"/>
                    
                    <DataGridTemplateColumn Header="État" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#2ecc71" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,2">
                                    <TextBlock Text="PRÊT" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="Progression" IsReadOnly="True" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" 
                          ResizeDirection="Rows" 
                          Background="#DDD" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch"/>

            <TabControl Grid.Row="2"
                        ItemsSource="{Binding SelectedJobs}">

                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="model:BackupJob">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="model:BackupJob">
                        <StackPanel Margin="10" Spacing="5">
                            <TextBlock Text="Source :" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SourcePath}"/>

                            <TextBlock Text="Destination :" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DestinationPath}"/>
                            
                            <TextBlock Text="Type :" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Type}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </Grid>
</Window>