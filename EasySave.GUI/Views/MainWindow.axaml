<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasySave.GUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="EasySave.GUI.Views.MainWindow"
        x:DataType="vm:BackupViewModel"
        Title="EasySave"
        Width="1200" Height="700">
    
    <Grid RowDefinitions="*,Auto" Margin="10">
        
        <Grid Grid.Row="0" ColumnDefinitions="2*,1*" ColumnSpacing="10">
            
            <Border Grid.Column="0" 
                    BorderBrush="Gray" 
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="5">
                <DataGrid ItemsSource="{Binding Jobs}"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Width="40"/>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="50"/>
                        <DataGridTextColumn Header="Nom"
                                            Binding="{Binding Name}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Chemin Source"
                                            Binding="{Binding SourcePath}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Chemin Destination"
                                            Binding="{Binding DestinationPath}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            
            <Border Grid.Column="1" 
                    BorderBrush="LightGray" 
                    BorderThickness="1"
                    CornerRadius="5"
                    Background="WhiteSmoke"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="Détails du job" 
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,10"/>
                </StackPanel>
            </Border>
            
        </Grid>
        
        <Border Grid.Row="1" 
                BorderBrush="Gray" 
                BorderThickness="1"
                CornerRadius="5"
                Background="WhiteSmoke"
                Padding="15"
                Margin="0,10,0,0">
            
            <Grid ColumnDefinitions="*,Auto">
                
       
                <StackPanel Grid.Column="0" 
                            VerticalAlignment="Center"
                            Spacing="5">
                    <TextBlock Text="Progression : En attente..." 
                               FontSize="12"
                               Foreground="Gray"/>
                    <ProgressBar Height="20"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 ShowProgressText="True"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            Spacing="10"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <Button Content="Ajouter" 
                            Width="100"
                            Height="35"
                            Click="AddJob_Click"/>
                    <Button Content="Exécuter" 
                            Width="100"
                            Height="35"
                            />
                    <Button Content="Supprimer" 
                            Width="100"
                            Height="35"
                            />
                    <Button Content="Pause" 
                            Width="100"
                            Height="35"
                            />
                </StackPanel>
                
            </Grid>
            
        </Border>
        
    </Grid>
        
</Window>