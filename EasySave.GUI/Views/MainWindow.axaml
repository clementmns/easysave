<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasySave.GUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="EasySave.GUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="EasySave"
        Icon="avares://EasySave.GUI/Assets/ico/Logo.ico"
        xmlns:model="clr-namespace:EasySave.Core.Model;assembly=EasySave.Core"
        xmlns:resources="clr-namespace:EasySave.GUI.Resources"
        xmlns:converters="clr-namespace:EasySave.GUI.Converters"
        Width="1200" Height="700">
    <Window.Resources>
        <converters:SelectedJobsContainsConverter x:Key="SelectedJobsContainsConverter" />
    </Window.Resources>

    <!--Remove cell selection-->
    <Window.Styles>
        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, Auto, *">

        <Border Grid.Row="0" Background="#8961CC" Padding="20,10">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Svg Path="avares://EasySave.GUI/Assets/svg/Logo.svg"
                         Width="30" Height="30" />
                    <TextBlock Text="EasySave"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center" />
                </StackPanel>
                
                <Button Grid.Column="2"
                        Background="Transparent"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="8"
                        Cursor="Hand"
                        Command="{Binding OpenSettingsDialogCommand}"
                        CommandParameter="{Binding $parent[Window]}">
                    <Svg Path="avares://EasySave.GUI/Assets/svg/settings.svg"
                         Width="18" Height="18" Css=".White { stroke: #FFF; }"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding OpenCreateJobDialog}" CommandParameter="{Binding $parent[Window]}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="+" FontWeight="Bold" Foreground="#8961CC" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static resources:Messages.add}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Fill="Gray" Margin="5,2" VerticalAlignment="Stretch" />
                <Button Content="{x:Static resources:Messages.execute}" Background="Transparent" BorderThickness="0"
                        Command="{Binding ExecuteSelectedJobs}" />
                <Button Content="{x:Static resources:Messages._break}" Background="Transparent" BorderThickness="0" />
                <Button Content="{x:Static resources:Messages.delete}" Background="Transparent" BorderThickness="0"
                        Foreground="Red" Command="{Binding DeleteSelectedJobsCommand}" />
                <Rectangle Width="1" Fill="Gray" Margin="5,2" VerticalAlignment="Stretch" />
                <Button Content="{x:Static resources:Messages.executeAll}" Background="Transparent" BorderThickness="0"
                        Command="{Binding ExecuteAllJobs}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" MinHeight="300" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Border Background="White"
                        IsVisible="{Binding !Jobs.Count}">
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                Spacing="20">
                        <Svg Path="/Assets/svg/arrow_up.svg" 
                             Width="64" 
                             Height="64" 
                             Opacity="0.2"/>
                        <TextBlock Text="{x:Static resources:Messages.noJobs}" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Static resources:Messages.addInstruction}" 
                                   FontSize="14"
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"/>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding Jobs}"
                          IsVisible="{Binding !!Jobs.Count}"
                          AutoGenerateColumns="False"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowBackground="White">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="100" CanUserResize="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        IsThreeState="True"
                                        IsChecked="{Binding ((vm:MainViewModel)DataContext).AreAllJobsSelected, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Command="{Binding ((vm:MainViewModel)DataContext).ToggleAllSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Command="{Binding ((vm:MainViewModel)DataContext).ToggleSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <CheckBox.IsChecked>
                                            <MultiBinding Converter="{StaticResource SelectedJobsContainsConverter}">
                                                <Binding Path="((vm:MainViewModel)DataContext).SelectedJobs"
                                                         RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding />
                                            </MultiBinding>
                                        </CheckBox.IsChecked>
                                    </CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="{x:Static resources:Messages.name}" Binding="{Binding Name}" Width="2*"
                                            IsReadOnly="True" FontWeight="SemiBold" />

                        <DataGridTextColumn Header="{x:Static resources:Messages.size}" IsReadOnly="True" Width="100" />

                        <DataGridTemplateColumn Header="{x:Static resources:Messages.state}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" Padding="8,2"
                                            Background="{Binding State.IsActive}">
                                        <TextBlock Text="{Binding State.IsActive}" Foreground="Black" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{x:Static resources:Messages.test}" IsReadOnly="True" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Margin="20 10" Height="20"
                                             Minimum="0" Maximum="100" Value="{Binding State.Progression}"
                                             ShowProgressText="True" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Grid>

            <GridSplitter Grid.Row="1"
                          ResizeDirection="Rows"
                          Background="#DDD"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

                    <Grid Grid.Row="2">
            <Border Background="#F9FAFB"
                    IsVisible="{Binding !SelectedJobs.Count}">
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Spacing="15">
                    <Svg Path="/Assets/svg/info.svg" 
                         Width="48" 
                         Height="48" 
                         Opacity="0.3"/>
                    <TextBlock Text="{x:Static resources:Messages.noJobSelected}" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static resources:Messages.selectJobText}" 
                               FontSize="14"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <TabControl ItemsSource="{Binding SelectedJobs}"
                        IsVisible="{Binding !!SelectedJobs.Count}">
                
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="model:BackupJob">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="model:BackupJob">
                        <Border Background="White"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="10"
                                Padding="20"
                                BoxShadow="0 4 10 0 #10000000">

                            <Grid RowDefinitions="Auto, *, Auto">

                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Détails de la sauvegarde" FontSize="12" Foreground="Gray" />
                                        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold"
                                                   Foreground="#333" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="6" Padding="10,5"
                                            VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Svg Path="/Assets/svg/info.svg" Width="16" Height="16" />
                                            <TextBlock Text="{Binding Type}" FontWeight="SemiBold" Foreground="#555" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto, *" Margin="0,0,0,20"
                                      VerticalAlignment="Top">

                                    <Border Grid.Column="0" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                            BorderThickness="1" CornerRadius="6" Padding="15" MinHeight="80">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Svg Path="/Assets/svg/folder.svg" Width="18" Height="18" />
                                                <TextBlock Text="Dossier Source" FontWeight="Bold" Foreground="#374151" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap"
                                                       Foreground="#6B7280" />
                                        </StackPanel>
                                    </Border>

                                    <Svg Grid.Column="1" Path="/Assets/svg/arrow_right.svg" Width="24" Height="24"
                                         Margin="15,0" Opacity="0.3" />

                                    <Border Grid.Column="2" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                            BorderThickness="1" CornerRadius="6" Padding="15" MinHeight="80">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Svg Path="/Assets/svg/folder.svg" Width="18" Height="18" />
                                                <TextBlock Text="Dossier Destination" FontWeight="Bold"
                                                           Foreground="#374151" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DestinationPath}" TextWrapping="Wrap"
                                                       Foreground="#6B7280" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" BorderBrush="#EEE" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                        
                                        <Button Command="{Binding ((vm:MainViewModel)DataContext).OpenEditJobDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding .}" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="15,8" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Svg Path="/Assets/svg/pencil.svg" Width="14" Height="14" />
                                                <TextBlock Text="Éditer" />
                                            </StackPanel>
                                        </Button>

                                        <Button Background="#8961CC" Foreground="White" CornerRadius="4" Padding="15,8"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Command="{Binding ((vm:MainViewModel)DataContext).ExecuteJobCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Svg Path="/Assets/svg/play.svg" Width="14" Height="14" />
                                                <TextBlock Text="Lancer maintenant" />
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
        </Grid>
    </Grid>
</Window>
