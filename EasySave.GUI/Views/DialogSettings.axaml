<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EasySave.GUI.ViewModels;assembly=EasySave.GUI"
             xmlns:ressources="clr-namespace:EasySave.GUI.Resources"
             x:DataType="vm:SettingsDialogViewModel"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="500"
             x:Class="EasySave.GUI.Views.DialogSettings"
             x:Name="DialogSettingsRoot">
    <Design.DataContext>
        <vm:SettingsDialogViewModel></vm:SettingsDialogViewModel>
    </Design.DataContext>
    <Border Padding="20" Background="{StaticResource SurfaceBrush}">
        <ScrollViewer>
            <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Static ressources:Messages.settings}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{x:Static ressources:Messages.customizeSettings}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <Border Padding="16" CornerRadius="8" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Static ressources:Messages.Language}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{x:Static ressources:Messages.languageText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguageDisplay}"
                                  PlaceholderText="{x:Static ressources:Messages.selectLanguage}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Static ressources:Messages.logFormat}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{x:Static ressources:Messages.chooseBackupText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding LogFormats}" SelectedItem="{Binding SelectedLogFormat}"
                                  PlaceholderText="Select log format" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
                
                <Border Padding="16" CornerRadius="8" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Crypted Extensions" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Choose extensions to be crypted :"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        
                        <!-- new extension -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding NewExtension}" 
                                     Watermark="e.g., .pdf or pdf"
                                     Width="200" 
                                     VerticalContentAlignment="Center" />
                            <Button Content="Add" 
                                    Command="{Binding AddExtensionCommand}"
                                    Classes="primary" />
                        </StackPanel>
                        
                        <!-- current extensions -->
                        <Border BorderBrush="{StaticResource BorderSoftBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4"
                                Padding="8"
                                MinHeight="100"
                                MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CryptedExtensions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="x:String"
                                                      x:DataType="vm:SettingsDialogViewModel">
                                            <Border Padding="8,4" 
                                                    Margin="0,2"
                                                    Background="{StaticResource SurfaceBrush}"
                                                    CornerRadius="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding}" 
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <Button Grid.Column="1" 
                                                            Content="Remove"
                                                            Command="{Binding $parent[UserControl].DataContext.RemoveExtensionCommand}"
                                                            CommandParameter="{Binding .}"
                                                            Classes="ghost" 
                                                            Foreground="{StaticResource ErrorBrush}"
                                                            Padding="8,4" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,4,0,0">
                    <Button Content="{x:Static ressources:Messages.cancel}" Command="{Binding CancelCommand}"
                            Classes="ghost" />
                    <Button Content="{x:Static ressources:Messages.save}" Command="{Binding SaveCommand}"
                            Classes="primary" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>