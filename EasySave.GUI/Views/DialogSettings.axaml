<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EasySave.GUI.ViewModels;assembly=EasySave.GUI"
             x:DataType="vm:SettingsDialogViewModel"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="500"
             x:Class="EasySave.GUI.Views.DialogSettings"
             x:Name="DialogSettingsRoot">
    <Design.DataContext>
        <vm:SettingsDialogViewModel></vm:SettingsDialogViewModel>
    </Design.DataContext>
    <Border Padding="20" Background="{StaticResource SurfaceBrush}">
        <ScrollViewer>
            <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource customizeSettings}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <Border Padding="16" CornerRadius="8" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Language}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource languageText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguageDisplay}"
                                  PlaceholderText="{DynamicResource selectLanguage}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

              
                <Border Padding="16" CornerRadius="8" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource priorityExtensions}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource choosePriorityExt}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding NewPriorityExtension}"
                                     Watermark="e.g., .pdf or pdf"
                                     Width="200"
                                     VerticalContentAlignment="Center" />
                            <Button Content="{DynamicResource add}"
                                    Command="{Binding AddPriorityExtensionCommand}"
                                    Classes="primary" />
                        </StackPanel>

                        
                        <Border BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                MinHeight="100"
                                MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PriorityExtensions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="x:String"
                                                      x:DataType="vm:SettingsDialogViewModel">
                                            <Border Padding="8,4"
                                                    Margin="0,2"
                                                    Background="{StaticResource SurfaceBrush}"
                                                    CornerRadius="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <Button Grid.Column="1"
                                                            Content="{DynamicResource remove}"
                                                            Command="{Binding ((vm:SettingsDialogViewModel)DataContext).RemovePriorityExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding .}"
                                                            Classes="ghost"
                                                            Foreground="{StaticResource ErrorBrush}"
                                                            Padding="8,4" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource logFormat}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource chooseBackupText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding LogFormats}" SelectedItem="{Binding SelectedLogFormat}"
                                  PlaceholderText="{DynamicResource selectLogFormat}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource logMode}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource logModeText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding LogModes}" SelectedItem="{Binding SelectedLogMode}"
                                  PlaceholderText="{DynamicResource selectLogMode}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                        IsVisible="{Binding IsRemoteSettingsVisible}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource remoteServer}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource remoteServerText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource remoteHost}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding LogServerHost}" Watermark="localhost" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4">
                                <TextBlock Text="{DynamicResource remotePort}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <NumericUpDown Value="{Binding LogServerPort}" FormatString="0" Minimum="0" Maximum="65535" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Ressources -->
                <Border Padding="16" CornerRadius="8" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource cryptedExtensions}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource chooseExt}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- new extension -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding NewExtension}"
                                     Watermark="e.g., .pdf or pdf"
                                     Width="200"
                                     VerticalContentAlignment="Center" />
                            <Button Content="{DynamicResource add}"
                                    Command="{Binding AddExtensionCommand}"
                                    Classes="primary" />
                        </StackPanel>

                        <!-- current extensions -->
                        <Border BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                MinHeight="100"
                                MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CryptedExtensions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="x:String"
                                                      x:DataType="vm:SettingsDialogViewModel">
                                            <Border Padding="8,4"
                                                    Margin="0,2"
                                                    Background="{StaticResource SurfaceBrush}"
                                                    CornerRadius="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <Button Grid.Column="1"
                                                            Content="{DynamicResource remove}"
                                                            Command="{Binding ((vm:SettingsDialogViewModel)DataContext).RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding .}"
                                                            Classes="danger"
                                                            Foreground="{StaticResource ErrorBrush}"
                                                            Padding="8,4" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource SoftwareTitle}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Software}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding BusinessSoftwareProcessName}"
                                 Watermark="{DynamicResource SoftwareProcessName}"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,4,0,0">
                    <Button Content="{DynamicResource cancel}" Command="{Binding CancelCommand}"
                            Classes="ghost" />
                    <Button Content="{DynamicResource save}" Command="{Binding SaveCommand}"
                            Classes="primary" IsEnabled="{Binding CanSaveSettings}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>