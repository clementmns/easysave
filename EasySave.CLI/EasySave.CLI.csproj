<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Publish options -->
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <Version>3.0.0</Version>
        <RootNamespace>EasySave.CLI</RootNamespace>
        <!-- Branding -->
        <Authors>ProSoft</Authors>
        <Company>ProSoft</Company>
        <Product>EasySave.CLI</Product>
        <Copyright>Copyright © 2026 ProSoft</Copyright>
        <AssemblyTitle>EasySave.CLI</AssemblyTitle>
        <AssemblyDescription>Backup your files</AssemblyDescription>
        <AssemblyCompany>ProSoft</AssemblyCompany>
        <AssemblyProduct>EasySave.CLI</AssemblyProduct>
        <AssemblyCopyright>Copyright © 2026 ProSoft</AssemblyCopyright>
        <PublishAot>False</PublishAot>
        <SignAssembly>False</SignAssembly>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\EasySave.Core\EasySave.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resources\Messages.fr-FR.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Language.fr-FR.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\Messages.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Language.en-US.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\Messages.es-ES.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Messages.es-ES.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\Messages.it-IT.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Messages.it-IT.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\Messages.de-DE.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Messages.de-DE.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Resources\Messages.es-ES.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Messages.es-ES.resx</DependentUpon>
      </Compile>
      <Compile Update="Resources\Messages.it-IT.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Messages.it-IT.resx</DependentUpon>
      </Compile>
      <Compile Update="Resources\Messages.de-DE.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Messages.de-DE.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
